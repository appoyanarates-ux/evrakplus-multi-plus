{
  "appId": "com.evrakplus.dersdagitim.multiplus",
  "productName": "EvrakPlus Ders Dağıtım Multi Plus",
  "executableName": "EvrakPlusMultiPlus",
  "copyright": "Copyright © 2026 EvrakPlus",
  "electronVersion": "34.5.8",
  "npmRebuild": false,
  "asar": true,
  "directories": {
    "output": "../../dist/windows"
  },
  "files": [
    "src/**/*",
    "package.json",
    {
      "from": "../../packages/core-schema",
      "to": "packages/core-schema",
      "filter": ["package.json", "src/**/*.js"]
    },
    {
      "from": "../../packages/validator",
      "to": "packages/validator",
      "filter": ["package.json", "src/**/*.js"]
    },
    {
      "from": "../../packages/multi-solver",
      "to": "packages/multi-solver",
      "filter": ["package.json", "src/**/*.js"]
    },
    {
      "from": "../../packages/auth-client",
      "to": "packages/auth-client",
      "filter": ["package.json", "src/**/*.js"]
    },
    {
      "from": "../../packages/reports",
      "to": "packages/reports",
      "filter": ["package.json", "src/**/*.js"]
    },
    {
      "from": "../../packages/sync-engine",
      "to": "packages/sync-engine",
      "filter": ["package.json", "src/**/*.js"]
    },
    {
      "from": "../../engines",
      "to": "engines",
      "filter": ["*/adapter.js", "minizinc/dzn-generator.js"]
    }
  ],
  "extraResources": [
    {
      "from": "../../packages/ui-shared/public",
      "to": "ui-shared/public"
    },
    {
      "from": "../../engines/ortools/solver_cpsat.py",
      "to": "engines/ortools/solver_cpsat.py"
    },
    {
      "from": "../../engines/scip/solver_scip.py",
      "to": "engines/scip/solver_scip.py"
    },
    {
      "from": "../../engines/highs/solver_highs.py",
      "to": "engines/highs/solver_highs.py"
    },
    {
      "from": "../../engines/minizinc/model.mzn",
      "to": "engines/minizinc/model.mzn"
    },
    {
      "from": "../../resources/engines",
      "to": "engines"
    },
    {
      "from": "../../resources/runtime",
      "to": "runtime"
    },
    {
      "from": "../../resources/licenses",
      "to": "licenses"
    }
  ],
  "win": {
    "signAndEditExecutable": false,
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "artifactName": "EvrakPlus-Multi-Plus-${version}-${target}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "EvrakPlus Ders Dağıtım Multi Plus",
    "artifactName": "EvrakPlus-Multi-Plus-${version}-Setup.${ext}"
  },
  "portable": {
    "artifactName": "EvrakPlus-Multi-Plus-${version}-Portable.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "appoyanarates-ux",
      "repo": "evrakplus-multi-plus"
    }
  ]
}
