{
  "name": "dersmatrix-ultimate",
  "version": "2.7.4",
  "description": "DersMatrix Ultimate by EvrakPlus — Windows 64-bit Electron Masaüstü Uygulaması",
  "type": "module",
  "main": "./src/main.js",
  "author": "EvrakPlus",
  "homepage": "https://www.evrakplus.com/ders-dagitim-multi-plus/",
  "scripts": {
    "start": "electron .",
